# Database (Supabase pooler connection string — get from Supabase dashboard)
DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Email provider: "resend" or "gmail_smtp"
EMAIL_PROVIDER=resend

# Resend (used when EMAIL_PROVIDER=resend) — needs a verified domain to send to real clients
RESEND_API_KEY=
EMAIL_FROM=enquiries@yourdomain.com

# Gmail SMTP fallback (used when EMAIL_PROVIDER=gmail_smtp) — no domain needed
# EMAIL_FROM=yourcompany@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password

# Company inbox that receives every enquiry notification
EMAIL_TO=leads@yourcompany.com

# Auth
JWT_SECRET=generate-a-long-random-string-here
FRONTEND_ORIGIN=https://your-site.vercel.app

# Rate limiting
RATE_LIMIT_PER_MINUTE=5
