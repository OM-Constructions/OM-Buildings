# ==========================================
# Database Configuration
# ==========================================
# Local SQLite fallback:
DATABASE_URL=sqlite:///./om_buildings.db

# Supabase Managed PostgreSQL:
# Go to: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI or Pooling)
# Replace [project-ref] and [YOUR-PASSWORD] with your actual Supabase project values:
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# ==========================================
# Authentication & Security
# ==========================================
JWT_SECRET=replace-with-a-secure-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
VERIFICATION_TOKEN_EXPIRE_HOURS=24

# ==========================================
# External Services & Frontend
# ==========================================
FRONTEND_URL=http://localhost:8000
RESEND_API_KEY=
