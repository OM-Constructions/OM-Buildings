# Database (Supabase pooler connection string)
DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Email Configuration (SMTP)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourcompany@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=yourcompany@gmail.com

# Company inbox that receives every enquiry notification
COMPANY_NOTIFICATION_EMAIL=yourcompany@gmail.com
EMAIL_TO=yourcompany@gmail.com

# Auth
JWT_SECRET=generate-a-long-random-string-here
FRONTEND_URL=https://your-site.vercel.app
FRONTEND_ORIGIN=https://your-site.vercel.app

# Rate limiting
RATE_LIMIT_PER_MINUTE=5
